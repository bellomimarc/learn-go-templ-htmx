// Package dashboard contiene i template Templ per la dashboard gestionale.
package dashboard

import (
	"fmt"
	"time"
)

templ LoanApplicationPage(locale Locale, form LoanFormData, state LoanValidationState) {
	@Layout(locale.Text("loan.title"), locale, "/dashboard/loan") {
		<div class="card loan-card">
			<h2>{ locale.Text("loan.heading") }</h2>
			<p class="loan-subtitle">
				{ locale.Text("loan.subtitle") }
			</p>
			<p style="margin-top: 0.75rem;">
				<a href={ localizedPath("/dashboard", locale) } style="color: #667eea; text-decoration: underline;">{ locale.Text("loan.back") }</a>
			</p>
		</div>

		<div class="card loan-card">
			<style>
				.loan-card {
					max-width: 980px;
					margin-left: auto;
					margin-right: auto;
				}
				.loan-subtitle {
					margin-top: 0.75rem;
					line-height: 1.6;
					color: #4b4b4b;
				}
				.loan-grid {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 1rem;
				}
				.loan-field {
					display: flex;
					flex-direction: column;
					gap: 0.4rem;
				}
				.loan-field--full {
					grid-column: 1 / -1;
				}
				.loan-label {
					font-size: 0.93rem;
					font-weight: 600;
					color: #303246;
				}
				.loan-input,
				.loan-select {
					width: 100%;
					padding: 0.7rem 0.85rem;
					border: 1px solid #cfd4e7;
					border-radius: 8px;
					font-size: 0.95rem;
					transition: border-color 0.2s ease, box-shadow 0.2s ease;
				}
				.loan-input:focus,
				.loan-select:focus {
					outline: none;
					border-color: #667eea;
					box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.18);
				}
				.loan-input.is-invalid[data-touched="true"],
				.loan-select.is-invalid[data-touched="true"] {
					border-color: #d32f2f;
					background: #fff8f8;
				}
				.loan-input[data-touched="true"]:invalid,
				.loan-select[data-touched="true"]:invalid {
					border-color: #d32f2f;
					background: #fff8f8;
				}
				.loan-input[data-touched="true"]:invalid:focus,
				.loan-select[data-touched="true"]:invalid:focus {
					box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.2);
				}
				.loan-hint {
					font-size: 0.82rem;
					color: #667085;
				}
				.loan-error {
					font-size: 0.82rem;
					color: #b3261e;
					font-weight: 600;
				}
				.loan-native-error {
					display: none;
					font-size: 0.8rem;
					color: #b3261e;
					font-weight: 500;
				}
				.loan-input[data-touched="true"]:invalid + .loan-native-error,
				.loan-select[data-touched="true"]:invalid + .loan-native-error {
					display: block;
				}
				.loan-check {
					display: flex;
					align-items: center;
					gap: 0.6rem;
					padding-top: 1.85rem;
				}
				.loan-actions {
					margin-top: 1.2rem;
					display: flex;
					align-items: center;
					gap: 1rem;
				}
				.loan-actions button[disabled] {
					background: #9fa8da;
					cursor: not-allowed;
				}
				.loan-live {
					margin-top: 1.25rem;
				}
				.loan-panel {
					background: #f8f9ff;
					border: 1px solid #d8def8;
					border-radius: 10px;
					padding: 1rem;
				}
				.loan-panel h4 {
					margin-bottom: 0.8rem;
					color: #2b3360;
				}
				.loan-list {
					margin-left: 1rem;
					line-height: 1.6;
				}
				.loan-list--errors {
					color: #a60f2d;
				}
				.loan-list--warnings {
					color: #9a5a00;
				}
				.loan-metrics {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 0.8rem;
					margin-top: 1rem;
				}
				.loan-metric {
					padding: 0.8rem;
					background: white;
					border-radius: 8px;
					border: 1px solid #e6e9f7;
				}
				.loan-metric-label {
					display: block;
					font-size: 0.8rem;
					color: #52586f;
				}
				.loan-metric-value {
					display: block;
					margin-top: 0.25rem;
					font-size: 1rem;
					font-weight: 700;
					color: #273051;
				}
				.loan-result {
					margin-top: 1rem;
				}
				@media (max-width: 860px) {
					.loan-grid,
					.loan-metrics {
						grid-template-columns: 1fr;
					}
				}
			</style>

			<form
				id="loan-form"
				hx-post={ localizedPath("/dashboard/loan/validate", locale) }
				hx-trigger="input changed delay:250ms, change"
				hx-target="#loan-live-feedback"
				hx-swap="innerHTML"
				hx-on:input="if (event.target.matches('.loan-input, .loan-select')) { event.target.dataset.touched = 'true'; }"
				hx-on:change="if (event.target.matches('.loan-input, .loan-select')) { event.target.dataset.touched = 'true'; }"
			>
				<input type="hidden" name="lang" value={ locale.Code }/>
				<div class="loan-grid">
					<div class="loan-field">
						<label class="loan-label" for="full_name">{ locale.Text("loan.label.full_name") }</label>
						<input class={ "loan-input " + loanInputClass(state, "full_name") } id="full_name" name="full_name" value={ form.FullName } placeholder={ locale.Text("loan.placeholder.full_name") } required minlength="3" pattern="(?:.*\S){3,}" title={ locale.Text("loan.title.full_name") }/>
						<p class="loan-native-error">{ locale.Text("loan.title.full_name") }</p>
						@LoanFieldError(state, "full_name")
					</div>
					<div class="loan-field">
						<label class="loan-label" for="birth_date">{ locale.Text("loan.label.birth_date") }</label>
						<input class={ "loan-input " + loanInputClass(state, "birth_date") } id="birth_date" type="date" name="birth_date" value={ form.BirthDate } required max={ maxBirthDate() }/>
						<p class="loan-native-error">{ locale.Text("loan.title.birth_date") }</p>
						@LoanFieldError(state, "birth_date")
					</div>

					<div class="loan-field">
						<label class="loan-label" for="employment_type">{ locale.Text("loan.label.employment_type") }</label>
						<select class={ "loan-select " + loanInputClass(state, "employment_type") } id="employment_type" name="employment_type">
							<option value="">{ locale.Text("loan.option.employment.placeholder") }</option>
							<option value="salaried" if form.EmploymentType == "salaried" { selected }>{ locale.Text("loan.option.employment.salaried") }</option>
							<option value="self_employed" if form.EmploymentType == "self_employed" { selected }>{ locale.Text("loan.option.employment.self_employed") }</option>
							<option value="contractor" if form.EmploymentType == "contractor" { selected }>{ locale.Text("loan.option.employment.contractor") }</option>
						</select>
						@LoanFieldError(state, "employment_type")
					</div>

					<div class="loan-field">
						<label class="loan-label" for="purpose">{ locale.Text("loan.label.purpose") }</label>
						<select class="loan-select" id="purpose" name="purpose">
							<option value="">{ locale.Text("loan.option.purpose.placeholder") }</option>
							<option value="home_purchase" if form.Purpose == "home_purchase" { selected }>{ locale.Text("loan.option.purpose.home_purchase") }</option>
							<option value="home_renovation" if form.Purpose == "home_renovation" { selected }>{ locale.Text("loan.option.purpose.home_renovation") }</option>
							<option value="debt_consolidation" if form.Purpose == "debt_consolidation" { selected }>{ locale.Text("loan.option.purpose.debt_consolidation") }</option>
							<option value="business" if form.Purpose == "business" { selected }>{ locale.Text("loan.option.purpose.business") }</option>
						</select>
					</div>

					<div class="loan-field">
						<label class="loan-label" for="annual_income">{ locale.Text("loan.label.annual_income") }</label>
						<input class={ "loan-input " + loanInputClass(state, "annual_income") } id="annual_income" type="number" name="annual_income" value={ form.AnnualIncome } placeholder={ locale.Text("loan.placeholder.annual_income") } required min="0.01" step="0.01"/>
						<p class="loan-native-error">{ locale.Text("loan.title.annual_income") }</p>
						@LoanFieldError(state, "annual_income")
					</div>
					<div class="loan-field">
						<label class="loan-label" for="monthly_debt">{ locale.Text("loan.label.monthly_debt") }</label>
						<input class={ "loan-input " + loanInputClass(state, "monthly_debt") } id="monthly_debt" name="monthly_debt" value={ form.MonthlyDebt } placeholder={ locale.Text("loan.placeholder.monthly_debt") }/>
						@LoanFieldError(state, "monthly_debt")
					</div>

					<div class="loan-field">
						<label class="loan-label" for="loan_amount">{ locale.Text("loan.label.loan_amount") }</label>
						<input class={ "loan-input " + loanInputClass(state, "loan_amount") } id="loan_amount" type="number" name="loan_amount" value={ form.LoanAmount } placeholder={ locale.Text("loan.placeholder.loan_amount") } required min="100.01" step="0.01"/>
						<p class="loan-native-error">{ locale.Text("loan.title.loan_amount") }</p>
						@LoanFieldError(state, "loan_amount")
					</div>
					<div class="loan-field">
						<label class="loan-label" for="loan_years">{ locale.Text("loan.label.loan_years") }</label>
						<input class={ "loan-input " + loanInputClass(state, "loan_years") } id="loan_years" name="loan_years" value={ form.LoanYears } placeholder={ locale.Text("loan.placeholder.loan_years") }/>
						@LoanFieldError(state, "loan_years")
					</div>

					<div class="loan-field">
						<label class="loan-label" for="down_payment">{ locale.Text("loan.label.down_payment") }</label>
						<input class={ "loan-input " + loanInputClass(state, "down_payment") } id="down_payment" name="down_payment" value={ form.DownPayment } placeholder={ locale.Text("loan.placeholder.down_payment") }/>
						<p class="loan-hint">{ locale.Text("loan.hint.down_payment") }</p>
						@LoanFieldError(state, "down_payment")
					</div>
					<div class="loan-field">
						<label class="loan-label" for="collateral_value">{ locale.Text("loan.label.collateral_value") }</label>
						<input class={ "loan-input " + loanInputClass(state, "collateral_value") } id="collateral_value" name="collateral_value" value={ form.CollateralValue } placeholder={ locale.Text("loan.placeholder.collateral_value") }/>
						@LoanFieldError(state, "collateral_value")
					</div>

					<div class="loan-field loan-check">
						<input id="has_guarantor" type="checkbox" name="has_guarantor" value="true" if form.HasGuarantor { checked }/>
						<label class="loan-label" for="has_guarantor">{ locale.Text("loan.label.guarantor") }</label>
					</div>
					<div class="loan-field">
						<label class="loan-label" for="guarantor_income">{ locale.Text("loan.label.guarantor_income") }</label>
						<input class={ "loan-input " + loanInputClass(state, "guarantor_income") } id="guarantor_income" name="guarantor_income" value={ form.GuarantorIncome } placeholder={ locale.Text("loan.placeholder.guarantor_income") }/>
						@LoanFieldError(state, "guarantor_income")
					</div>
				</div>

				<div class="loan-actions" id="loan-submit-controls">
					@LoanSubmitControls(locale, state)
				</div>
			</form>

			<div class="loan-live" id="loan-live-feedback">
				@LoanValidationPanel(locale, state)
			</div>
			<div class="loan-result" id="loan-submit-result"></div>
		</div>
	}
}

templ LoanValidationResponse(locale Locale, state LoanValidationState) {
	@LoanValidationPanel(locale, state)
	<div id="loan-submit-controls" hx-swap-oob="true" class="loan-actions">
		@LoanSubmitControls(locale, state)
	</div>
}

templ LoanValidationPanel(locale Locale, state LoanValidationState) {
	<div class="loan-panel">
		<h4>{ locale.Text("loan.validation.title") }</h4>
		if !state.HasEvaluated {
			<p>{ locale.Text("loan.validation.waiting") }</p>
		} else {
			if len(state.Errors) > 0 {
				<p><strong>{ locale.Text("loan.validation.blocking") }</strong></p>
				<ul class="loan-list loan-list--errors">
					for _, issue := range state.Errors {
						<li>{ issue.Message }</li>
					}
				</ul>
			} else {
				<p><strong>{ locale.Text("loan.validation.clear") }</strong> { locale.Text("loan.validation.submittable") }</p>
			}

			if len(state.Warnings) > 0 {
				<p style="margin-top: 0.85rem;"><strong>{ locale.Text("loan.validation.warnings") }</strong></p>
				<ul class="loan-list loan-list--warnings">
					for _, warning := range state.Warnings {
						<li>{ warning }</li>
					}
				</ul>
			}

			if state.TermMonths > 0 {
				<div class="loan-metrics">
					<div class="loan-metric">
						<span class="loan-metric-label">{ locale.Text("loan.metric.net_income") }</span>
						<span class="loan-metric-value">{ formatCurrency(state.NetMonthlyIncome) }</span>
					</div>
					<div class="loan-metric">
						<span class="loan-metric-label">{ locale.Text("loan.metric.installment") }</span>
						<span class="loan-metric-value">{ formatCurrency(state.EstimatedInstallment) }</span>
					</div>
					<div class="loan-metric">
						<span class="loan-metric-label">{ locale.Text("loan.metric.dti") }</span>
						<span class="loan-metric-value">{ fmt.Sprintf("%.2f%%", state.DebtToIncomeRatio) }</span>
					</div>
					<div class="loan-metric">
						<span class="loan-metric-label">{ locale.Text("loan.metric.employment_cap") }</span>
						<span class="loan-metric-value">{ formatCurrency(state.MaximumLoanAmount) }</span>
					</div>
					<div class="loan-metric">
						<span class="loan-metric-label">{ locale.Text("loan.metric.down_payment") }</span>
						<span class="loan-metric-value">{ fmt.Sprintf("%.2f%%", state.DownPaymentRatio) }</span>
					</div>
					<div class="loan-metric">
						<span class="loan-metric-label">{ locale.Text("loan.metric.rate") }</span>
						<span class="loan-metric-value">{ fmt.Sprintf("%.2f%%", state.InterestRate) }</span>
					</div>
				</div>
			}
		}
	</div>
}

templ LoanSubmitControls(locale Locale, state LoanValidationState) {
	<button
		type="button"
		hx-post={ localizedPath("/dashboard/loan/submit", locale) }
		hx-include="#loan-form"
		hx-target="#loan-submit-result"
		hx-swap="innerHTML"
		if !state.IsValid {
			disabled
		}
	>
		{ locale.Text("loan.submit") }
		<span class="htmx-indicator spinner"></span>
	</button>
	if state.HasEvaluated && !state.IsValid {
		<span class="loan-hint">{ locale.Text("loan.submit.blocked") }</span>
	}
}

templ LoanFieldError(state LoanValidationState, field string) {
	if msg := loanFieldError(state, field); msg != "" {
		<p class="loan-error">{ msg }</p>
	}
}

templ LoanSubmissionResult(locale Locale, message string, severity string) {
	@AlertComponent(message, severity)
}

func loanFieldError(state LoanValidationState, field string) string {
	for _, issue := range state.Errors {
		if issue.Field == field {
			return issue.Message
		}
	}
	return ""
}

func loanInputClass(state LoanValidationState, field string) string {
	if loanFieldError(state, field) != "" {
		return "is-invalid"
	}
	return ""
}

func formatCurrency(value float64) string {
	return fmt.Sprintf("EUR %.2f", value)
}

func maxBirthDate() string {
	return time.Now().AddDate(-18, 0, 0).Format("2006-01-02")
}
