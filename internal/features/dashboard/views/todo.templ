// Package dashboard contiene i template Templ per la dashboard gestionale.
package dashboard

import "fmt"

templ TodoPage(locale Locale, todos []TodoView, errorMessage string) {
	@Layout(locale.Text("todo.title"), locale, "/dashboard/todos") {
		<div class="card todo-shell">
			<style>
				.todo-shell { max-width: 820px; margin-left: auto; margin-right: auto; }
				.todo-heading { display: flex; justify-content: space-between; align-items: start; gap: 1rem; margin-bottom: 1.5rem; }
				.todo-heading p { color: #52586f; margin-top: 0.4rem; line-height: 1.5; }
				.todo-back { color: #4f60bf; font-weight: 600; white-space: nowrap; }
				.todo-create, .todo-edit { display: flex; gap: 0.65rem; }
				.todo-input { min-width: 0; flex: 1; padding: 0.75rem 0.85rem; border: 1px solid #cfd4e7; border-radius: 6px; font: inherit; }
				.todo-input:focus { outline: none; border-color: #667eea; box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.18); }
				.todo-error { margin: 0.85rem 0; padding: 0.75rem; background: #fff3f3; color: #a60f2d; border-left: 3px solid #c62828; }
				.todo-list { list-style: none; margin-top: 1.25rem; display: grid; gap: 0.75rem; }
				.todo-item { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 0.65rem; align-items: center; padding: 0.85rem; border: 1px solid #e1e4ef; border-radius: 8px; background: #fafbff; }
				.todo-item--completed .todo-input { text-decoration: line-through; color: #667085; background: #f2f4f7; }
				.todo-action { padding: 0.7rem 0.9rem; }
				.todo-action--secondary { background: #475467; }
				.todo-action--danger { background: #b42318; }
				.todo-empty { margin-top: 1.25rem; padding: 1.5rem; text-align: center; color: #667085; border: 1px dashed #cfd4e7; border-radius: 8px; }
				@media (max-width: 680px) {
					.todo-heading { flex-direction: column; }
					.todo-create { flex-direction: column; }
					.todo-item { grid-template-columns: 1fr 1fr; }
					.todo-edit { grid-column: 1 / -1; }
				}
			</style>
			<div class="todo-heading">
				<div>
					<h2>{ locale.Text("todo.heading") }</h2>
					<p>{ locale.Text("todo.subtitle") }</p>
				</div>
				<a class="todo-back" href={ localizedPath("/dashboard", locale) }>{ locale.Text("todo.back") }</a>
			</div>
			@TodoRegion(locale, todos, errorMessage)
		</div>
	}
}

templ TodoRegion(locale Locale, todos []TodoView, errorMessage string) {
	<div id="todos-region">
		<form
			class="todo-create"
			hx-post={ localizedPath("/api/todos", locale) }
			hx-target="#todos-region"
			hx-swap="outerHTML"
		>
			<label class="sr-only" for="new-todo-title">{ locale.Text("todo.label.title") }</label>
			<input id="new-todo-title" class="todo-input" name="title" required placeholder={ locale.Text("todo.placeholder") }/>
			<button type="submit">{ locale.Text("todo.add") }</button>
		</form>
		if errorMessage != "" {
			<p class="todo-error" role="alert">{ errorMessage }</p>
		}
		if len(todos) == 0 {
			<p class="todo-empty">{ locale.Text("todo.empty") }</p>
		} else {
			<ul class="todo-list">
				for _, todo := range todos {
					@TodoItem(locale, todo)
				}
			</ul>
		}
	</div>
}

templ TodoItem(locale Locale, todo TodoView) {
	<li id={ fmt.Sprintf("todo-%d", todo.ID) } class={ "todo-item", templ.KV("todo-item--completed", todo.Completed) }>
		<form
			class="todo-edit"
			hx-put={ localizedPath(fmt.Sprintf("/api/todos/%d", todo.ID), locale) }
			hx-target="#todos-region"
			hx-swap="outerHTML"
		>
			<label class="sr-only" for={ fmt.Sprintf("todo-title-%d", todo.ID) }>{ locale.Text("todo.label.title") }</label>
			<input id={ fmt.Sprintf("todo-title-%d", todo.ID) } class="todo-input" name="title" value={ todo.Title } required/>
			<button class="todo-action" type="submit">{ locale.Text("todo.save") }</button>
		</form>
		<button
			class="todo-action todo-action--secondary"
			type="button"
			hx-patch={ localizedPath(fmt.Sprintf("/api/todos/%d/toggle", todo.ID), locale) }
			hx-target="#todos-region"
			hx-swap="outerHTML"
		>
			if todo.Completed {
				{ locale.Text("todo.reopen") }
			} else {
				{ locale.Text("todo.complete") }
			}
		</button>
		<button
			class="todo-action todo-action--danger"
			type="button"
			hx-delete={ localizedPath(fmt.Sprintf("/api/todos/%d", todo.ID), locale) }
			hx-target="#todos-region"
			hx-swap="outerHTML"
			hx-confirm={ locale.Text("todo.delete.confirm") }
		>
			{ locale.Text("todo.delete") }
		</button>
	</li>
}