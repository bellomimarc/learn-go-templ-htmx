// Package dashboard contiene i template Templ per la dashboard gestionale.
package dashboard

templ Dashboard(locale Locale) {
	@Layout(locale.Text("dashboard.title"), locale, "/dashboard") {
		<div class="card">
			<h2>{ locale.Text("dashboard.welcome.title") }</h2>
			<p style="margin-top: 1rem; line-height: 1.6;">
				{ locale.Text("dashboard.welcome.body") }
			</p>
			<ul style="margin: 1rem 0 0 1.5rem; line-height: 2;">
				<li><strong>Chi/v5:</strong> { locale.Text("dashboard.stack.chi") }</li>
				<li><strong>Templ:</strong> { locale.Text("dashboard.stack.templ") }</li>
				<li><strong>HTMX:</strong> { locale.Text("dashboard.stack.htmx") }</li>
				<li><strong>stdlib encoding/json:</strong> { locale.Text("dashboard.stack.json") }</li>
			</ul>
		</div>

		<div class="card">
			<h3>📡 { locale.Text("dashboard.communication.title") }</h3>
			<p style="margin-top: 1rem; line-height: 1.6;">
				{ locale.Text("dashboard.communication.body") }
			</p>
		</div>

		<div class="card">
			<h3>🎯 Componente Interattivo (HTMX + Templ)</h3>
			<p style="margin-bottom: 1rem;">
				<button 
					hx-get={ localizedPath("/dashboard/status", locale) }
					hx-target="#status-container"
					hx-swap="innerHTML"
				>
					{ locale.Text("dashboard.communication.button") }
					<span class="htmx-indicator spinner"></span>
				</button>
			</p>
			<div id="status-container" style="margin-top: 1.5rem; padding: 1rem; background: #f5f5f5; border-radius: 6px; min-height: 3rem; display: flex; align-items: center; color: #999;">
				{ locale.Text("dashboard.communication.placeholder") }
			</div>
		</div>

		<div class="card">
			<h3>🔗 { locale.Text("dashboard.rest.title") }</h3>
			<p style="margin-top: 1rem;">
				{ locale.Text("dashboard.rest.body") }
			</p>
		</div>

		<div class="card" style="background: #f7f8ff; border-left: 4px solid #5b6fd8;">
			<h3>{ locale.Text("dashboard.todo.title") }</h3>
			<p style="margin-top: 1rem; line-height: 1.6;">
				{ locale.Text("dashboard.todo.body") }
			</p>
			<p style="margin-top: 1rem;">
				<a href={ localizedPath("/dashboard/todos", locale) } style="color: #4f60bf; text-decoration: underline; font-weight: 600;">{ locale.Text("dashboard.todo.link") }</a>
			</p>
		</div>

		<div class="card" style="background: #f7f8ff; border-left: 4px solid #5b6fd8;">
			<h3>🧪 { locale.Text("dashboard.loan.title") }</h3>
			<p style="margin-top: 1rem; line-height: 1.6;">
				{ locale.Text("dashboard.loan.body") }
			</p>
			<p style="margin-top: 1rem;">
				<a href={ localizedPath("/dashboard/loan", locale) } style="color: #4f60bf; text-decoration: underline; font-weight: 600;">{ locale.Text("dashboard.loan.link") }</a>
			</p>
		</div>

		<div class="card" style="background: #f7f8ff; border-left: 4px solid #5b6fd8;">
			<h3>📨 { locale.Text("dashboard.events.title") }</h3>
			<p style="margin-top: 1rem; line-height: 1.6;">
				{ locale.Text("dashboard.events.body") }
			</p>
			<p style="margin-top: 1rem;">
				<a href={ localizedPath("/dashboard/events", locale) } style="color: #4f60bf; text-decoration: underline; font-weight: 600;">{ locale.Text("dashboard.events.link") }</a>
			</p>
		</div>

		<div class="card" style="background: #f0f4ff; border-left: 4px solid #667eea;">
			<strong>💡 { locale.Text("dashboard.arch.title") }:</strong>
			<ul style="margin: 1rem 0 0 1.5rem; line-height: 1.8;">
				<li>{ locale.Text("dashboard.arch.item.1") }</li>
				<li>{ locale.Text("dashboard.arch.item.2") }</li>
				<li>{ locale.Text("dashboard.arch.item.3") }</li>
				<li>{ locale.Text("dashboard.arch.item.4") }</li>
				<li>{ locale.Text("dashboard.arch.item.5") }</li>
			</ul>
		</div>
	}
}