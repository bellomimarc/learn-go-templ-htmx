# Application runtime configuration.
# Copy this file to .env for local development. Do not commit .env.

# PostgreSQL used by the application and migrations.
# `make run` and `make dev` start this database automatically.
DATABASE_URL=postgres://saas_poc:saas_poc@localhost:5432/saas_poc?sslmode=disable

# OIDC issuer configured by the local ZITADEL stack.
ZITADEL_ISSUER=http://auth.localhost:8081

# Required by the server. `make idp-up` writes the generated value here.
ZITADEL_CLIENT_ID=replace-with-client-id-from-make-idp-up

# Public origin of this application, used to build the OIDC callback URL.
APPLICATION_ORIGIN=http://localhost:8080